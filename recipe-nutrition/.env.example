# =============================================
# 한국 공공데이터 API 키 설정
# =============================================
# 이 파일을 복사해서 .env 로 저장 후 실제 키를 입력하세요
# .env 는 절대 git에 올리지 마세요 (.gitignore에 추가)

# -------------------------------------
# [1] 식품의약품안전처 - 조리식품 레시피 DB
# 발급: https://www.data.go.kr 검색 → "식품의약품안전처_조리식품의 레시피 DB 정보"
# -------------------------------------
MFDS_API_KEY=your_mfds_api_key_here

# -------------------------------------
# [2] 농촌진흥청 - 통합식품영양성분정보
# 발급: https://www.data.go.kr 검색 → "농촌진흥청_국립농업과학원_통합식품영양성분정보"
# -------------------------------------
RDA_API_KEY=your_rda_api_key_here

# -------------------------------------
# [3] KAMIS - 농산물유통정보 가격 API
# 발급: https://www.kamis.or.kr → 오픈API 신청
# -------------------------------------
KAMIS_API_KEY=your_kamis_api_key_here
KAMIS_API_ID=your_kamis_api_id_here

# -------------------------------------
# [4] 앱 설정
# -------------------------------------
# true = 샘플 데이터 사용 (실제 API 미호출)
# false = 실제 공공데이터 API 호출
USE_MOCK=true

# 서버 포트
PORT=8000

# CORS 허용 오리진 (개발 시 *)
ALLOWED_ORIGINS=*
